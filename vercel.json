{
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/order/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; form-action https://sandbox.payfast.co.za https://www.payfast.co.za; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.php/books/",
      "destination": "/books/",
      "permanent": true
    },
    {
      "source": "/index.php/request-quote/",
      "destination": "/request-quote/",
      "permanent": true
    },
    {
      "source": "/index.php/contact/",
      "destination": "/contact/",
      "permanent": true
    },
    {
      "source": "/index.php/about/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy-2/",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/refund_returns/",
      "permanent": true
    },
    {
      "source": "/catalogue/",
      "destination": "/books/",
      "permanent": true
    },
    {
      "source": "/quote/",
      "destination": "/request-quote/",
      "permanent": true
    }
  ]
}
