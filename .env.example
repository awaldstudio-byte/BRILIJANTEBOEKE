# Supabase project. Publishable key is used only by the server-side login client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Separate application secret used to derive parent order-access tokens.
# Generate at least 32 random bytes and do not reuse another project secret.
ORDER_TOKEN_SECRET=replace_with_a_long_random_secret

# Public application origin without a trailing slash.
APP_ORIGIN=https://www.briljanteboeke.co.za

# Start with sandbox. Change only after the full sandbox acceptance run passes.
PAYFAST_MODE=sandbox
# Set true only after merchant activation and the sandbox acceptance run.
PAYFAST_LIVE_ENABLED=false
PAYFAST_MERCHANT_ID=replace_me
PAYFAST_MERCHANT_KEY=replace_me
PAYFAST_PASSPHRASE=replace_me

# Optional comma-separated staff notification recipients.
BRILJANTE_NOTIFICATION_EMAILS=info@briljanteboeke.co.za

# Existing authorised domain sender; disabled until authentication and delivery tests.
MAIL_ENABLED=false
MAIL_FROM=orders@briljanteboeke.co.za
MAIL_REPLY_TO=info@briljanteboeke.co.za
SMTP_HOST=replace_with_existing_provider
SMTP_PORT=465
SMTP_USER=replace_with_authorised_sender
SMTP_PASSWORD=replace_with_app_or_smtp_password
